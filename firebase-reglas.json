{
  "rules": {
    "v2": {
      "salas": {
        "$sala": {
          ".validate": "$sala.matches(/^[a-z0-9_-]{1,24}$/)",
          "players": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && data.child('t').val() < now - 45000))",
              ".validate": "newData.hasChildren(['ch', 'st', 't'])",
              "ch": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "nm": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "st": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "du": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "dx": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "h": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "th": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "bk": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "cr": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "gr": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "ay": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "sp": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "fl": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "pr": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
              "pt": { ".validate": "newData.val() === 0 || newData.val() === 1" },
              "sb": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "sc": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 5000000" },
              "t": { ".validate": "newData.val() === now" },
              "$otro": { ".validate": false }
            }
          },
          "msgs": {
            ".read": "auth != null",
            ".indexOn": ["at"],
            "$mid": {
              ".write": "auth != null && ((!data.exists() && newData.child('id').val() === auth.uid) || (!newData.exists() && (data.child('id').val() === auth.uid || data.child('at').val() < now - 120000)))",
              ".validate": "newData.hasChildren(['id', 'nm', 'at']) && ((newData.hasChildren(['ev', 'to']) && !newData.hasChild('tx') && !newData.hasChild('au')) || (newData.hasChild('tx') && !newData.hasChild('ev') && !newData.hasChild('au')) || (newData.hasChild('au') && !newData.hasChild('ev') && !newData.hasChild('tx')))",
              "id": { ".validate": "newData.isString()" },
              "nm": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "at": { ".validate": "newData.val() === now" },
              "ev": { ".validate": "newData.val() === 'push' || newData.val() === 'duel' || newData.val() === 'hit'" },
              "to": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "ty": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
              "sb": { ".validate": "newData.val() === 1 && newData.parent().child('ev').val() === 'push'" },
              "tx": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "au": { ".validate": "newData.isString() && newData.val().length <= 100000 && newData.val().beginsWith('data:audio/')" },
              "$otro": { ".validate": false }
            }
          }
        }
      },
      "records": {
        "$temporada": {
          ".read": "auth != null",
          ".indexOn": ["best", "bestWave"],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "$temporada.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['nm', 'best', 'bestWave', 'at']) && (!data.exists() || (newData.child('best').val() >= data.child('best').val() && newData.child('bestWave').val() >= data.child('bestWave').val()))",
            "nm": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "ch": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 5000000" },
            "bestWave": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 5000000" },
            "bestTube": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
            "legends": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
            "sessions": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000" },
            "tricks": {
              "$truco": { ".validate": "$truco.length <= 30 && newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000" }
            },
            "at": { ".validate": "newData.val() === now" },
            "$otro": { ".validate": false }
          }
        }
      }
    },
    "salas": {
      "$sala": {
        "players": {
          ".read": true,
          "$pid": {
            ".write": true,
            ".validate": "newData.val() == null || (newData.hasChildren(['ch', 'st']) && newData.child('ch').isString() && newData.child('ch').val().length < 20)"
          }
        },
        "msgs": {
          ".read": true,
          ".indexOn": [
            "at"
          ],
          "$mid": {
            ".write": true,
            ".validate": "newData.val() == null || (newData.child('at').isNumber() && (newData.child('ev').exists() ? ((newData.child('ev').val() == 'push' || newData.child('ev').val() == 'duel' || newData.child('ev').val() == 'hit') && newData.child('to').isString() && newData.child('to').val().length < 40) : newData.child('tx').exists() ? (newData.child('tx').isString() && newData.child('tx').val().length <= 80) : (newData.child('au').isString() && newData.child('au').val().length < 400000)))"
          }
        }
      }
    },
    "stats": {
      ".read": true,
      ".indexOn": [
        "best",
        "bestWave",
        "season"
      ],
      "$dev": {
        ".write": "newData.exists() && $dev.length <= 24",
        ".validate": "newData.hasChildren(['nm', 'best', 'bestWave']) && newData.child('nm').isString() && newData.child('nm').val().length <= 20 && newData.child('best').isNumber() && newData.child('best').val() >= 0 && newData.child('best').val() < 5000000 && newData.child('bestWave').isNumber() && newData.child('bestWave').val() >= 0 && newData.child('bestWave').val() < 5000000 && newData.child('season').val() == 2 && (!data.exists() || data.child('season').val() != 2 || newData.child('best').val() >= data.child('best').val())"
      }
    }
  }
}
